# Опционально. Без этого ключа приложение полностью работает — рекомендации
# считаются детерминированно, а объяснения формируются по шаблону (см. README,
# раздел "Ограничения"). Если ключ указан, доступна кнопка ИИ-объяснения
# с проверкой истории и альтернатив на kk/ru/en. Страница не ждёт вызов API.
OPENAI_API_KEY=

# Модель для генерации объяснений (по умолчанию gpt-4o-mini, если ключ задан).
OPENAI_MODEL=gpt-4o-mini

DEMO_MODE=true
HR_PASSWORD=
EMPLOYEE_PASSWORDS_JSON=
SESSION_SECRET=
SECURE_COOKIES=false
