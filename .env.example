# Опционально. Без этого ключа приложение полностью работает — рекомендации
# считаются детерминированно, а объяснения формируются по шаблону (см. README,
# раздел "Ограничения"). Если ключ указан, объяснения становятся более
# естественными и локализованными (kk/ru/en) за счёт LLM.
OPENAI_API_KEY=

# Модель для генерации объяснений (по умолчанию gpt-4o-mini, если ключ задан).
OPENAI_MODEL=gpt-4o-mini
